# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copia este archivo a .env y completa las credenciales deseadas:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEEDORES DE IA (OPCIONALES)
# Si no configuras ninguna clave de IA, el sistema activa automáticamente
# el motor de respaldo heurístico local determinista (100% offline y gratuito).
# ------------------------------------------------------------------------------

# Google AI Studio (Proveedor Titular - Gemini 3.5 Flash / 3.6 Flash - 3.5 rutea a 3.6 desde oct-2026)
# Consigue tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Groq (Suplente 1 - Inferencia ultrarrápida LPU / llama-3.3-70b-versatile)
# Consigue tu clave gratuita en: https://console.groq.com/
GROQ_API_KEY=tu_groq_api_key_aqui

# Cloudflare Workers AI (Suplente 2 - 10.000 neuronas/día gratis)
# Consigue credenciales en: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=tu_cloudflare_account_id_aqui
CLOUDFLARE_API_TOKEN=tu_cloudflare_api_token_aqui

# Mistral AI (Suplente 3 - mistral-small-latest)
# Consigue tu clave en: https://console.mistral.ai/
MISTRAL_API_KEY=tu_mistral_api_key_aqui

# ------------------------------------------------------------------------------
# 2. TELEGRAM (OPCIONAL - SOLO PARA EL CENTINELA EN TIEMPO REAL)
# Necesario únicamente si vas a ejecutar scripts/telegram_centinela.py
# Consigue tu API ID y HASH en: https://my.telegram.org/apps
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=tu_telegram_api_hash_hexadecimal

# Bot y Chat ID para recibir alertas push privadas en tu celular (BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXYZ
TELEGRAM_CHAT_ID=tu_telegram_chat_id_numerico

# ------------------------------------------------------------------------------
# 3. SINCRONIZACIÓN Y EXPORTACIÓN LOCAL (OPCIONAL)
# Ruta secundaria donde sincronizar automáticamente dashboard.html y CSVs compilados
# Ejemplo en Linux/macOS: /home/usuario/Documents/Prospeccion
# Ejemplo en Windows:     C:\Users\tu_usuario\Documents\Prospeccion
# ------------------------------------------------------------------------------
PROSPECTOR_EXPORT_DIR=
