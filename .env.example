# -------------------------------------------------------------------------------
# 1. PROVEEDOR TITULAR (Recomendado): Google Gemini (Google AI Studio)
# Cuota gratuita: 500 llamadas/dia, 15 RPM, 250.000 TPM
# Obten tu clave gratis sin tarjeta en: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------------------------
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# -------------------------------------------------------------------------------
# 2. PROVEEDOR SUPLENTE 1 (Volumen): Cloudflare Workers AI
# Cuota gratuita: 10.000 Neuronas/dia (~1.700 clasificaciones gratis al dia)
# Obten tu Account ID y API Token gratis en: https://dash.cloudflare.com
# -------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# -------------------------------------------------------------------------------
# 3. PROVEEDOR SUPLENTE 2 (Velocidad): Groq LPU
# Cuota gratuita: 1.000 llamadas/dia, 30 RPM (8.000 TPM)
# Obten tu clave gratis sin tarjeta en: https://console.groq.com/keys
# -------------------------------------------------------------------------------
GROQ_API_KEY=

# -------------------------------------------------------------------------------
# 4. PROVEEDOR SUPLENTE 3 (Español): Mistral AI (La Plateforme)
# Cuota gratuita: 1 req/segundo, cuota mensual amplia de evaluacion
# Obten tu clave gratis sin tarjeta en: https://console.mistral.ai
# -------------------------------------------------------------------------------
MISTRAL_API_KEY=
